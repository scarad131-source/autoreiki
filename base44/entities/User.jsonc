{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "reminder_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Si el recordatorio diario de Reiki est\u00e1 activo"
    },
    "reminder_time": {
      "type": "string",
      "description": "Hora local del recordatorio en formato HH:MM (pasos de 15 min)"
    },
    "reminder_timezone": {
      "type": "string",
      "description": "Zona horaria IANA del usuario para calcular el recordatorio"
    },
    "reiki_reminders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "description": "D\u00eda de la semana (1=Lun ... 7=Dom)"
          },
          "time": {
            "type": "string",
            "description": "Hora en formato HH:MM"
          }
        },
        "required": [
          "day",
          "time"
        ]
      },
      "description": "Recordatorios de la Agenda Reiki del usuario"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}