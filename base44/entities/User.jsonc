{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "preferred_name": {
      "type": "string",
      "description": "Nombre con el que el usuario prefiere ser llamado en la app"
    },
    "practice_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate"
      ],
      "description": "Nivel de pr\u00e1ctica actual del usuario"
    },
    "reminder_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Si el recordatorio diario de Reiki est\u00e1 activo"
    },
    "reminder_time": {
      "type": "string",
      "description": "Hora local del recordatorio en formato HH:MM (pasos de 15 min)"
    },
    "reminder_timezone": {
      "type": "string",
      "description": "Zona horaria IANA del usuario para calcular el recordatorio"
    },
    "reiki_schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Fecha en formato YYYY-MM-DD"
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": {
                  "type": "string",
                  "description": "Hora en formato HH:MM"
                },
                "label": {
                  "type": "string",
                  "description": "Nombre/etiqueta de la sesi\u00f3n"
                }
              },
              "required": [
                "time",
                "label"
              ]
            }
          }
        },
        "required": [
          "date",
          "sessions"
        ]
      },
      "description": "Agenda Reiki del usuario por d\u00eda del mes"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}