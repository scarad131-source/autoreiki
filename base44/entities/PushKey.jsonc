{
  "name": "PushKey",
  "type": "object",
  "properties": {
    "public_key": {
      "type": "string",
      "description": "Clave p\u00fablica VAPID (la usa el navegador para suscribirse)"
    },
    "private_key": {
      "type": "string",
      "description": "Clave privada VAPID (solo la usan las funciones del servidor)"
    }
  },
  "required": [
    "public_key",
    "private_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}